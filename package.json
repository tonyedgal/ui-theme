{
  "name": "ui-theme",
  "version": "0.0.0",
  "description": "Cross-framework UI theme package monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:patch": "changeset add --type patch",
    "changeset:feature": "changeset add --type minor",
    "changeset:breaking": "changeset add --type major",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyedgal/ui-theme.git"
  },
  "keywords": [
    "theme",
    "ui",
    "react",
    "vue",
    "angular",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^22.20.5",
    "@vitest/ui": "^4.1.11",
    "antislop-plugin": "0.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1"
    }
  }
}
