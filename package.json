{
  "name": "ui-theme",
  "version": "0.0.0",
  "description": "Cross-framework UI theme package monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:patch": "changeset add --type patch",
    "changeset:feature": "changeset add --type minor",
    "changeset:breaking": "changeset add --type major",
    "changeset:version": "node .github/changeset-version.js",
    "changeset:publish": "pnpm build:packages && changeset publish",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test:commit": "node scripts/test-staged.mjs",
    "test:browser:smoke": "pnpm --filter uitheme-web build && pnpm --filter uitheme-web exec playwright test --project=chromium-dpr2 --grep \"declared ref|color palettes use|selects the current theme logo|reduced motion, unsupported|clicked element overrides\"",
    "test:release:consumers": "pnpm build:packages && node scripts/check-vue-release-consumer.mjs && node scripts/check-native-release-consumer.mjs",
    "build:packages": "turbo run build --filter=./packages/*",
    "test:release:native": "pnpm --filter uitheme-rn build && node scripts/check-native-release-consumer.mjs",
    "test:validation": "node --test scripts/tests/validation.test.mjs",
    "test:browsers:install": "pnpm --filter uitheme-web exec playwright install chromium firefox webkit",
    "test:local": "node scripts/validate.mjs --all",
    "test:release:registry": "node scripts/check-registry-release-consumers.mjs && pnpm test:registry:shadcn",
    "test:registry:shadcn": "node scripts/check-registry-shadcn.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyedgal/ui-theme.git"
  },
  "keywords": [
    "theme",
    "ui",
    "react",
    "vue",
    "angular",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "5.0.2",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@vitest/ui": "^5.0.5",
    "antislop-plugin": "0.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
