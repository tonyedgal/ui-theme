    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@ui-theme/registry": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
