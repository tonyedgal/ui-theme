      "base": "reka",
      "tailwind": 3,
      "language": "js",
      "webVersion": "^2.0.0",
      "cliVersion": "^1.0.0",
      "compatibleDependencies": {
        "@lucide/vue": "^1.0.1"
      }
    }
  }
}
