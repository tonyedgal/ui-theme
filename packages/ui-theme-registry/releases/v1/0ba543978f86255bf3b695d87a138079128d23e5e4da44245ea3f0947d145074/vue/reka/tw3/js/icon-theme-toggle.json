{
  "name": "icon-theme-toggle",
  "type": "registry:ui",
  "title": "Icon Theme Toggle",
  "description": "Animate between sun and moon icons while changing the UI theme.",
  "dependencies": [
    "@lucide/vue@^1.61.0"
  ],
  "registryDependencies": [
    "https://www.ui-theme.dev/r/v1/0ba543978f86255bf3b695d87a138079128d23e5e4da44245ea3f0947d145074/vue/reka/tw3/js/theme-toggle.json"
  ],
  "files": [
    {
      "path": "icon-theme-toggle.vue",
      "content": "<script setup>\nimport { shallowRef } from \"vue\";\nimport { SunIcon, MoonIcon } from \"@lucide/vue\";\nimport { useUITheme } from \"uitheme-web/vue\";\nimport ThemeToggle from \"./theme-toggle.vue\";\nimport { cn } from \"@/lib/utils\";\n\nconst props = defineProps({\n  duration: { type: Number, required: false, default: undefined },\n  animationType: { type: String, required: false },\n  slideDirection: { type: null, required: false, default: undefined },\n  effect: { type: String, required: false, default: \"rotate\" },\n  label: { type: String, required: false, default: undefined },\n  disabled: { type: Boolean, required: false },\n  borderStyle: { type: String, required: false, default: \"solid\" },\n  class: { type: String, required: false, default: undefined },\n  classes: { type: Object, required: false, default: undefined },\n});\n\nconst theme = useUITheme();\n\nconst keyboard = shallowRef(false);\n\nconst layer =\n  \"col-start-1 row-start-1 inline-flex size-4 items-center justify-center motion-reduce:!transform-none motion-reduce:!translate-x-0 motion-reduce:!rotate-0 motion-reduce:!scale-100 motion-reduce:!blur-none\";\n\nfunction hidden(side) {\n  return props.effect === \"slide\"\n    ? side === \"sun\"\n      ? \"-translate-x-2\"\n      : \"translate-x-2\"\n    : props.effect === \"blur\"\n      ? \"scale-75 blur-[4px]\"\n      : side === \"sun\"\n        ? \"-rotate-90 scale-75\"\n        : \"rotate-90 scale-75\";\n}\n</script>\n<template>\n  <ThemeToggle\n    v-bind=\"props\"\n    :class=\"props.class\"\n    :label=\"\n      label ??\n      `Switch to ${theme.resolvedTheme.value === 'dark' ? 'light' : 'dark'} theme`\n    \"\n    :classes=\"{\n      ...props.classes,\n      trigger: cn(\n        'w-10 px-0 active:scale-[0.96] motion-reduce:active:scale-100',\n        props.classes?.trigger,\n      ),\n    }\"\n    @keydown.capture=\"keyboard = true\"\n    @pointerdown.capture=\"keyboard = false\"\n  >\n    <span\n      aria-hidden=\"true\"\n      :data-effect=\"effect\"\n      class=\"grid size-4 overflow-hidden\"\n    >\n      <span\n        :class=\"[\n          layer,\n          keyboard\n            ? 'transition-none motion-reduce:transition-none'\n            : 'transition-[transform,translate,rotate,scale,opacity,filter] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-opacity motion-reduce:duration-100',\n          theme.resolvedTheme.value === 'dark'\n            ? ['opacity-0', hidden('sun')]\n            : 'opacity-100',\n        ]\"\n        ><SunIcon class=\"size-4\"\n      /></span>\n      <span\n        :class=\"[\n          layer,\n          keyboard\n            ? 'transition-none motion-reduce:transition-none'\n            : 'transition-[transform,translate,rotate,scale,opacity,filter] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-opacity motion-reduce:duration-100',\n          theme.resolvedTheme.value === 'dark'\n            ? 'opacity-100'\n            : ['opacity-0', hidden('moon')],\n        ]\"\n        ><MoonIcon class=\"size-4\"\n      /></span>\n    </span>\n  </ThemeToggle>\n</template>\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "uiTheme": {
      "schemaVersion": 1,
      "revision": "0ba543978f86255bf3b695d87a138079128d23e5e4da44245ea3f0947d145074",
