{
  "name": "theme-selector",
  "type": "registry:ui",
  "title": "Theme Selector",
  "description": "Choose an available appearance theme.",
  "dependencies": [
    "reka-ui@^2.11.0",
    "@lucide/vue@^1.61.0"
  ],
  "registryDependencies": [],
  "files": [
