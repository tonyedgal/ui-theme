{
  "name": "transition-settings",
  "type": "registry:ui",
  "title": "Transition Settings",
  "description": "Control the transition animation and duration.",
  "dependencies": [
    "reka-ui@^2.11.0",
    "tailwind-merge@^2.6.0"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "transition-settings.vue",
      "content": "<script setup>\nimport { computed } from \"vue\";\nimport {\n  SelectContent,\n  SelectItem,\n  SelectItemText,\n  SelectViewport,\n  SelectPortal,\n  SelectRoot,\n  SelectTrigger,\n  SelectValue,\n  SliderRange,\n  SliderRoot,\n  SliderThumb,\n  SliderTrack,\n} from \"reka-ui\";\nimport { ThemeAnimationType } from \"uitheme-web/core\";\nimport { DEFAULT_DURATION } from \"uitheme-web/core\";\nimport { mergeClasses } from \"./classes\";\n\nconst props = defineProps({\n  modelValue: {\n    type: Object,\n    required: false,\n    default: () => ({\n      animationType: ThemeAnimationType.CIRCLE,\n      duration: DEFAULT_DURATION,\n    }),\n  },\n  disabled: { type: Boolean, required: false, default: false },\n  class: { type: String, required: false, default: undefined },\n  classes: { type: null, required: false, default: undefined },\n  animationLabel: {\n    type: String,\n    required: false,\n    default: \"Transition effect\",\n  },\n  durationLabel: { type: String, required: false, default: \"Duration\" },\n});\n\nconst emit = defineEmits([\"update:modelValue\"]);\n\nconst animationTypes = [\n  ThemeAnimationType.CIRCLE,\n  ThemeAnimationType.BLUR_CIRCLE,\n  ThemeAnimationType.SLIDE,\n  ThemeAnimationType.CLIP_PATH,\n  ThemeAnimationType.POLYGON_GRADIENT,\n  ThemeAnimationType.TRIANGLE,\n];\n\nconst duration = computed(() =>\n  Math.min(2000, Math.max(0, Math.round(props.modelValue.duration / 50) * 50)),\n);\n\nconst rootClass = computed(() =>\n  mergeClasses(\n    \"flex w-full flex-col gap-4\",\n    props.class,\n    props.classes,\n    \"root\",\n  ),\n);\n\nconst triggerClass = computed(() =>\n  mergeClasses(\n    \"inline-flex min-w-48 items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\",\n    undefined,\n    props.classes,\n    \"trigger\",\n  ),\n);\n\nconst contentClass = computed(() =>\n  mergeClasses(\n    \"z-50 min-w-48 overflow-hidden rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md\",\n    undefined,\n    props.classes,\n    \"content\",\n  ),\n);\n\nconst itemClass = computed(() =>\n  mergeClasses(\n    \"relative flex cursor-default select-none items-center rounded-sm px-2 py-1.5 text-sm outline-none data-[highlighted]:bg-accent data-[highlighted]:text-accent-foreground\",\n    undefined,\n    props.classes,\n    \"item\",\n  ),\n);\n\nconst trackClass = computed(() =>\n  mergeClasses(\n    \"relative h-2 w-full grow overflow-hidden rounded-full bg-secondary\",\n    undefined,\n    props.classes,\n    \"track\",\n  ),\n);\n\nconst thumbClass = computed(() =>\n  mergeClasses(\n    \"block size-4 rounded-full border border-primary bg-background shadow transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\",\n    undefined,\n    props.classes,\n    \"thumb\",\n  ),\n);\n\nfunction update(patch) {\n  emit(\"update:modelValue\", { ...props.modelValue, ...patch });\n}\n\nfunction updateAnimation(value) {\n  const selected = animationTypes.find((type) => type === value);\n\n  if (selected) update({ animationType: selected });\n}\n\nfunction updateDuration(value) {\n  const next = value?.[0];\n\n  if (next !== undefined) update({ duration: next });\n}\n</script>\n\n<template>\n  <div :class=\"rootClass\">\n    <div class=\"flex flex-col gap-2\">\n      <label\n        :class=\"\n          mergeClasses(\n            'text-sm font-medium text-foreground',\n            undefined,\n            props.classes,\n            'label',\n          )\n        \"\n        >{{ animationLabel }}</label\n      >\n      <SelectRoot\n        :disabled=\"disabled\"\n        :model-value=\"modelValue.animationType\"\n        @update:model-value=\"updateAnimation\"\n      >\n        <SelectTrigger :class=\"triggerClass\" :aria-label=\"animationLabel\"\n          ><SelectValue\n        /></SelectTrigger>\n        <SelectPortal\n          ><SelectContent :class=\"contentClass\" position=\"popper\"\n            ><SelectViewport\n              ><SelectItem\n                v-for=\"type in animationTypes\"\n                :key=\"type\"\n                :value=\"type\"\n                :class=\"itemClass\"\n                ><SelectItemText>{{\n                  type\n                    .split(\"-\")\n                    .map((part) => part[0].toUpperCase() + part.slice(1))\n                    .join(\" \")\n                }}</SelectItemText></SelectItem\n              ></SelectViewport\n            ></SelectContent\n          ></SelectPortal\n        >\n      </SelectRoot>\n    </div>\n    <div class=\"flex flex-col gap-3\">\n      <div class=\"flex items-center justify-between gap-4\">\n        <label\n          :class=\"\n            mergeClasses(\n              'text-sm font-medium text-foreground',\n              undefined,\n              props.classes,\n              'label',\n            )\n          \"\n          >{{ durationLabel }}</label\n        >\n        <output\n          class=\"text-sm tabular-nums text-muted-foreground\"\n          aria-live=\"polite\"\n          >{{ duration }} ms</output\n        >\n      </div>\n      <SliderRoot\n        :disabled=\"disabled\"\n        class=\"relative flex w-full touch-none select-none items-center\"\n        :model-value=\"[duration]\"\n        :min=\"0\"\n        :max=\"2000\"\n        :step=\"50\"\n        :aria-label=\"durationLabel\"\n        @update:model-value=\"updateDuration\"\n      >\n        <SliderTrack :class=\"trackClass\"\n          ><SliderRange class=\"absolute h-full bg-primary\"\n        /></SliderTrack>\n        <SliderThumb\n          :aria-label=\"durationLabel\"\n          :class=\"thumbClass\"\n          :aria-valuetext=\"`${duration} milliseconds`\"\n        />\n      </SliderRoot>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "classes.js",
      "content": "import { twMerge } from 'tailwind-merge';\nexport function mergeClass(base, custom) {\n    return twMerge(base, custom);\n}\nexport function mergeClasses(base, custom, classes, slot) {\n    return twMerge(base, custom, slot ? classes?.[slot] : undefined);\n}\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "uiTheme": {
      "schemaVersion": 1,
      "revision": "4e7a5d76a371d269ce8f26549f7f2c19726d447271ebe1e630c5523168f12f24",
      "component": "transition-settings",
      "framework": "vue",
      "base": "reka",
      "tailwind": 3,
      "language": "js",
      "webVersion": "^2.0.0",
      "cliVersion": "^1.0.0"
    }
  }
}
