{
  "name": "uitheme-rn",
  "version": "1.0.0",
  "description": "Native appearance and color palettes for React Native and Expo",
  "type": "module",
  "license": "MIT",
  "author": "Tony Edgal (https://github.com/tonyedgal)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyedgal/ui-theme.git",
    "directory": "packages/ui-theme-rn"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./expo": {
      "import": {
        "types": "./dist/expo.d.ts",
        "default": "./dist/expo.js"
      },
      "require": {
        "types": "./dist/expo.d.cts",
        "default": "./dist/expo.cjs"
      }
    },
    "./package.json": "./package.json",
    "./reanimated": {
      "import": {
        "types": "./dist/reanimated.d.ts",
        "default": "./dist/reanimated.js"
      },
      "require": {
        "types": "./dist/reanimated.d.cts",
        "default": "./dist/reanimated.cjs"
      }
    },
    "./transitions": {
      "import": {
        "types": "./dist/transitions.d.ts",
        "default": "./dist/transitions.js"
      },
      "require": {
        "types": "./dist/transitions.d.cts",
        "default": "./dist/transitions.cjs"
      }
    },
    "./nativewind": {
      "import": {
        "types": "./dist/nativewind.d.ts",
        "default": "./dist/nativewind.js"
      },
      "require": {
        "types": "./dist/nativewind.d.cts",
        "default": "./dist/nativewind.cjs"
      }
    },
    "./uniwind": {
      "import": {
        "types": "./dist/uniwind.d.ts",
        "default": "./dist/uniwind.js"
      },
      "require": {
        "types": "./dist/uniwind.d.cts",
        "default": "./dist/uniwind.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SCREEN-TRANSITION-CHECKS.md",
    "STYLING-CHECKS.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "prepublishOnly": "pnpm build && pnpm test:package"
  },
  "peerDependencies": {
    "@expo/ui": ">=56.0.0 <58",
    "@shopify/react-native-skia": ">=2.11.1 <2.12",
    "react": ">=19.2.0 <20",
    "react-native": ">=0.83.0 <0.87",
    "react-native-reanimated": ">=4.5.1 <4.6",
    "react-native-worklets": ">=0.10.1 <0.11",
    "nativewind": "5.0.0-rc.0",
    "uniwind": ">=1.12.2 <2"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/ui": "~57.0.22",
    "@shopify/react-native-skia": "2.11.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "uniwind": "1.12.2",
    "react-native-css": "3.1.0-rc.0",
    "tailwindcss": "4.3.1",
    "lightningcss": "1.30.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
